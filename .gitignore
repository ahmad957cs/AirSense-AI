# ============================================================
# Large ML model artifacts
# ============================================================

*.joblib
*.pkl
*.h5

# Keep only small preprocessing artifacts needed for inference
!artifacts/preprocessing/tabular_imputer.joblib
!artifacts/preprocessing/feature_columns.json
!artifacts/preprocessing/feature_scaler.pkl
!artifacts/preprocessing/target_scaler.pkl

# Keep the LSTM model already tracked in models/lstm/
!models/lstm/
!models/lstm/airsense_lstm_72h_best.keras

# ============================================================
# Generated/local data
# ============================================================

# Ignore raw acquisition data
data/raw/

# Allow processed datasets needed by the examiner
!data/
!data/processed/
!data/processed/*.csv

